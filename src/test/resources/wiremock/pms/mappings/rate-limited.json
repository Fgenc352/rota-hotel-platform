{
  "name": "rate-limited",
  "scenarioName": "pms-delivery",
  "requiredScenarioState": "rate-limited",
  "request": {
    "method": "POST",
    "urlPath": "/reservations",
    "headers": {
      "Content-Type": {
        "contains": "application/json"
      },
      "Idempotency-Key": {
        "matches": "[0-9a-fA-F-]{36}"
      },
      "X-Trace-Id": {
        "matches": ".+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.eventId"
      },
      {
        "matchesJsonPath": "$.reservationId"
      },
      {
        "matchesJsonPath": "$.hotelId"
      },
      {
        "matchesJsonPath": "$.version"
      }
    ]
  },
  "response": {
    "status": 429,
    "headers": {
      "Retry-After": "1",
      "Content-Type": "application/json"
    },
    "bodyFileName": "rate-limited.json"
  }
}
