{
  "name": "rota-hotel-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4205 --proxy-config proxy.conf.json",
    "build": "ng build --configuration production --stats-json && node scripts/bundle-report.mjs",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "start:pms": "node ../pms-mock/server.mjs",
    "test:pms": "node --test ../pms-mock/*.test.mjs",
    "start:widget": "ng serve --host 0.0.0.0 --port 4305 --proxy-config proxy.conf.json"
  },
  "dependencies": {
    "@angular/common": "21.0.0",
    "@angular/compiler": "21.0.0",
    "@angular/core": "21.0.0",
    "@angular/forms": "21.0.0",
    "@angular/platform-browser": "21.0.0",
    "@angular/router": "21.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.0.0",
    "@angular/cli": "21.0.0",
    "@angular/compiler-cli": "21.0.0",
    "typescript": "5.9.3",
    "@playwright/test": "1.56.1"
  }
}
